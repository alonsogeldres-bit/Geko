<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GEKO - Seguridad</title>
  <script src="/js/theme.js"></script>
  <link rel="stylesheet" href="/css/profile.css" />
  <link rel="stylesheet" href="/css/configuracion.css" />
</head>
<body>

  <div class="profile-page bg-gradient<%= locals.usuarioPremium ? ' is-premium' : '' %>">

    <%- include('partials/header', { navVolver: true }) %>

    <main class="profile-main">

      <div class="profile-head anim-fade-in">
        <div class="profile-step-icon">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        </div>
        <div>
          <h1 class="profile-title">Seguridad</h1>
          <p class="muted step-desc">Protege tu cuenta con una contraseña que solo tú conozcas.</p>
        </div>
      </div>

      <div class="anim-slide-up">

        <%- include('partials/alert') %>

        <% if (locals.esLocal) { %>

          <section class="config-section">
            <h2 class="config-section-title">Cambiar contraseña</h2>

            <div class="field">
              <label class="field-label" for="actual">Contraseña actual</label>
              <input type="password" id="actual" class="input" autocomplete="current-password" />
              <span class="field-error" id="err-actual"></span>
            </div>

            <div class="field">
              <label class="field-label" for="nueva">Nueva contraseña</label>
              <input type="password" id="nueva" class="input" autocomplete="new-password" />
              <span class="field-hint">Mínimo 6 caracteres.</span>
              <span class="field-error" id="err-nueva"></span>
            </div>

            <div class="field">
              <label class="field-label" for="confirmacion">Repite la nueva contraseña</label>
              <input type="password" id="confirmacion" class="input" autocomplete="new-password" />
              <span class="field-error" id="err-confirmacion"></span>
            </div>
          </section>

          <div class="config-actions">
            <a href="/configuracion" class="btn btn-ghost">Volver</a>
            <button type="button" class="btn btn-primary" id="btn-save">Cambiar contraseña</button>
          </div>

        <% } else { %>

          <section class="config-section">
            <h2 class="config-section-title">Cuenta de Google</h2>
            <p class="config-note">
              Tu cuenta se creó con Google, así que la contraseña se gestiona desde tu
              cuenta de Google. No es necesario (ni posible) cambiarla aquí.
            </p>
          </section>

          <div class="config-actions">
            <a href="/configuracion" class="btn btn-ghost">Volver</a>
          </div>

        <% } %>

      </div>
    </main>
  </div>

  <% if (locals.esLocal) { %>
    <script src="/js/configuracion-seguridad.js" defer></script>
  <% } %>
</body>
</html>
