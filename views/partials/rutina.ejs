<%
  const r = locals.rutina || {};
  const p = locals.perfil || {};
  const calentamiento = r.calentamiento || [];
  const principal = r.rutinaPrincipal || [];
  const estiramiento = r.estiramiento || [];
  const esRespaldo = r.fuente === 'local';
  const motivo = [p.objetivo, p.nivelFisico, r.lugarEntrenamiento].filter(Boolean).join(' · ');

  const maxSolicitudes = Number(locals.maxSolicitudes) || 3;
  const restantes = Number(locals.restantes);
  const disponibles = Number.isFinite(restantes) ? Math.max(0, restantes) : maxSolicitudes;
  const limite = locals.limite === true || disponibles === 0;
%>

<section class="card hero">
  <span class="tag"><%= esRespaldo ? 'Rutina de respaldo' : 'Rutina de hoy' %></span>
  <h2 class="hero-title">Tu entrenamiento de hoy</h2>

  <div class="meta">
    <span><%= r.lugarEntrenamiento || p.entorno || 'Sin definir' %></span>
    <span>~<%= r.tiempoTotalMin || p.minutosSesion || 45 %> min</span>
    <span><%= principal.length %> ejercicios</span>
    <% if (p.objetivo) { %><span><%= p.objetivo %></span><% } %>
  </div>

  <p class="why">Adaptada a tu perfil: <b><%= motivo || 'datos de tu cuenta' %></b></p>

  <% if (esRespaldo) { %>
    <div class="rutina-aviso">
      <strong>Rutina de respaldo</strong>
      <span>
        No pudimos conectar con la IA en este momento, así que armamos una
        rutina local con tus datos. Si fue por el límite de uso, espera un
        minuto y pulsa “Generar otra rutina”.
      </span>
    </div>
  <% } %>

  <% if ((p.lesiones || []).length) { %>
    <div class="rutina-aviso">
      <strong>Ten en cuenta tus antecedentes</strong>
      <span>
        <%= p.lesiones.join(', ') %>. Ajusta o evita cualquier ejercicio
        que te cause dolor y consulta con un profesional si tienes dudas.
      </span>
    </div>
  <% } %>

  <div class="acts">
    <% if (limite) { %>
      <span class="cta is-disabled" aria-disabled="true">
        Límite alcanzado (<%= maxSolicitudes %>/<%= maxSolicitudes %>)
      </span>
    <% } else { %>
      <a class="cta" id="btn-nueva-rutina" href="/entrenamiento?nueva=1"
         data-restantes="<%= disponibles %>" data-max="<%= maxSolicitudes %>">↻ Generar otra rutina</a>
    <% } %>
    <a class="ghost" href="/dashboard">← Volver al dashboard</a>
  </div>

  <p class="rutina-contador">
    <% if (limite) { %>
      Ya usaste las <%= maxSolicitudes %> solicitudes de hoy. Vuelve mañana
      o cambia tu perfil para reiniciar el contador.
    <% } else { %>
      Solicitudes disponibles para “Generar otra rutina”:
      <b><%= disponibles %></b> de <%= maxSolicitudes %>.
    <% } %>
  </p>
</section>

<% if (calentamiento.length) { %>
  <section class="card">
    <h3>Calentamiento</h3>
    <ul class="rutina-lista">
      <% calentamiento.forEach(function (ej) { %>
        <li class="rutina-item">
          <div class="rutina-item-head">
            <strong><%= ej.nombre %></strong>
            <span class="chip"><%= ej.duracionMin %> min</span>
          </div>
          <% if (ej.descripcion) { %><p class="muted"><%= ej.descripcion %></p><% } %>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>

<% if (principal.length) { %>
  <section class="card">
    <h3>Rutina principal</h3>
    <p class="muted small">Series × repeticiones. En ejercicios isométricos, el segundo valor son segundos.</p>
    <ul class="rutina-lista">
      <% principal.forEach(function (ej) { %>
        <li class="rutina-item">
          <div class="rutina-item-head">
            <strong><%= ej.nombre %></strong>
            <span class="chip"><% if (ej.repeticiones <= 1) { %><%= ej.series %> series<% } else { %><%= ej.series %> × <%= ej.repeticiones %><% } %></span>
          </div>
          <% if (ej.descripcion) { %><p class="muted"><%= ej.descripcion %></p><% } %>
          <span class="rutina-descanso">Descanso entre series: <%= ej.descansoSeg %> s</span>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>

<% if (estiramiento.length) { %>
  <section class="card">
    <h3>Estiramiento</h3>
    <ul class="rutina-lista">
      <% estiramiento.forEach(function (ej) { %>
        <li class="rutina-item">
          <div class="rutina-item-head">
            <strong><%= ej.nombre %></strong>
            <span class="chip"><%= ej.duracionMin %> min</span>
          </div>
          <% if (ej.descripcion) { %><p class="muted"><%= ej.descripcion %></p><% } %>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>
