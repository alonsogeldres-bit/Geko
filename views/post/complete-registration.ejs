<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GEKO - Completa tu registro</title>
  <link rel="stylesheet" href="/css/login.css" />
</head>
<body>

  <div class="auth bg-gradient">

    <header class="auth-nav">
      <div class="logo-brand">
        <img src="/assets/geko.png" alt="GEKO" class="logo-img-small" width="34" height="34" />
        <span class="auth-brand">GEKO</span>
      </div>
    </header>

    <main class="auth-main">
      <div class="auth-card anim-fade-scale">

        <h1 class="auth-title">Completa tu registro</h1>
        <p class="auth-subtitle">
          Te identificamos con Google. Solo faltan estos datos para crear tu cuenta.
        </p>

        <div class="auth-sso-identity" role="group" aria-label="Identidad detectada">
          <img
            class="auth-sso-avatar"
            src="<%= data.foto || '/assets/geko.png' %>"
            alt=""
            width="36"
            height="36"
          />
          <div class="auth-sso-data">
            <span class="auth-sso-correo"><%= data.correo %></span>
          </div>
        </div>

        <div id="auth-alert"
             class="auth-alert"
             data-variant="error"
             role="alert"
             aria-live="assertive"
             hidden>
          <span class="auth-alert-icon" aria-hidden="true">!</span>
          <div class="auth-alert-body">
            <p class="auth-alert-msg" id="auth-alert-msg"></p>
          </div>
        </div>

        <form id="form-completar" class="auth-form" action="/complete-registration" method="POST">

          <input type="hidden" name="correo" value="<%= data.correo %>" />

          <label class="auth-label" for="profile-name">Nombre</label>
          <input
            type="text"
            id="profile-name"
            name="nombre"
            class="auth-input"
            value="<%= data.nombre %>"
            placeholder="Tu nombre"
            autocomplete="given-name"
            required
          />

          <label class="auth-label" for="profile-lastname">Apellido</label>
          <input
            type="text"
            id="profile-lastname"
            name="apellido"
            class="auth-input"
            placeholder="Tu apellido"
            autocomplete="family-name"
            required
          />

          <label class="auth-label" for="profile-username">Nombre de usuario</label>
          <input
            type="text"
            id="profile-username"
            name="nombre_usuario"
            class="auth-input"
            placeholder="usuario123"
            autocomplete="username"
            required
          />

          <label class="auth-label" for="profile-phone">Número de teléfono</label>
          <input
            type="tel"
            id="profile-phone"
            name="numero"
            class="auth-input"
            value="+56"
            data-prefijo="+56"
            placeholder="+56 9 1234 5678"
            autocomplete="tel"
            required
          />

          <label class="auth-label" for="profile-birthdate">Fecha de nacimiento</label>
          <input
            type="date"
            id="profile-birthdate"
            name="fecha_nacimiento"
            class="auth-input"
            autocomplete="bday"
            min="1900-01-01"
            max="<%= new Date().toISOString().slice(0, 10) %>"
            required
          />

          <button type="submit" class="btn btn-lg btn-primary auth-submit" id="btn-completar">
            <span class="btn-label">Crear mi cuenta</span>
          </button>

        </form>

        <div class="auth-nav-links">
          <a href="/login" class="btn btn-outline auth-nav-btn">Volver al inicio de sesión</a>
        </div>

      </div>
    </main>

  </div>

  <script src="/js/phone-prefix.js" defer></script>
  <script src="/js/complete-registration.js" defer></script>
</body>
</html>