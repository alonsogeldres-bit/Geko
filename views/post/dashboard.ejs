<%
  /* Todo lo que llega aquí viene del controlador con datos reales de la BD.
     Si algo falta, la vista degrada con honestidad en vez de inventar valores. */
  const u = locals.usuario || {};
  const p = locals.perfil || {};
  const nombre = u.nombre || 'Atleta';
  const inicial = nombre.charAt(0).toUpperCase();

  const esPremium = Boolean(locals.esPremium);       // plan de pago activo: look dorado
  const s = locals.sugerencia || {};
  const r = locals.resumen || { racha: 0, mejorRacha: 0, sesiones: 0, meta: 3, dias: [], hoy: 0 };
  const prog = locals.enProgreso || null;           // { hechos: 2, total: 5 } o null
  const actividad = locals.actividad || [];          // [{ nombre, detalle }]
  const calorias = locals.calorias || null;
  const diasSemana = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];
  const diasCompletos = ['Lunes', 'Martes', 'Miercoles', 'Jueves', 'Viernes', 'Sabado', 'Domingo'];

  /* Días que el usuario eligió en el wizard (perfil.dias). Si no hay, se usa
     lo que traiga el controlador en resumen.plan / resumen.meta. */
  const diasElegidos = Array.isArray(p.dias) ? p.dias : [];
  const planIdx = diasElegidos.length
    ? diasCompletos.map(function (d, i) { return diasElegidos.includes(d) ? i : -1; }).filter(function (i) { return i >= 0; })
    : (r.plan || []);
  const metaSemanal = diasElegidos.length || r.meta;

  const metaPct = metaSemanal ? Math.min(100, Math.round((r.sesiones / metaSemanal) * 100)) : 0;

  /* Menú del avatar. */
  const menu = [
    { href: '/configuracion', icono: '', texto: 'Configuración' },
    { href: '/planes',        icono: '', texto: 'Planes' },
    { href: '#',              icono: '', texto: 'Mi progreso',  pronto: true },
    { href: '#',              icono: '', texto: 'Ayuda',        pronto: true }
  ];
%>

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GEKO - Dashboard</title>
  <script src="/js/theme.js"></script>
  <link rel="stylesheet" href="/css/dashboard.css" />
  <link rel="stylesheet" href="/css/geko-mascot.css" />
</head>
<body>
  <div class="dash-page has-geko<%= esPremium ? ' is-premium' : '' %>">

    <!-- ========== Mascota Geko (camina por los laterales) ========== -->
    <%- include('../partials/geko_mascot') %>

    <!-- ========== Barra superior ========== -->
    <header class="dash-nav">
      <div class="logo-brand">
        <img src="/assets/geko-logo.png" alt="GEKO" width="30" height="30" data-logo />
        <span class="brand-text">GEKO</span>
        <% if (esPremium) { %><span class="premium-badge">Premium</span><% } %>
      </div>

      <details class="user-menu" id="user-menu">
        <summary class="avatar-btn" aria-label="Abrir menú de usuario"><%= inicial %></summary>

        <div class="dropdown" role="menu">
          <div class="dropdown-head">
            <strong><%= nombre %></strong>
            <span class="muted small">Mi cuenta</span>
          </div>

          <% menu.forEach(function (item) { %>
            <a href="<%= item.href %>" role="menuitem"
               class="dropdown-item<%= item.pronto ? ' is-soon' : '' %>">
              <span class="dropdown-ico"><%= item.icono %></span>
              <%= item.texto %>
              <% if (item.pronto) { %><span class="soon-tag">Pronto</span><% } %>
            </a>
          <% }) %>

          <button type="button" class="dropdown-item theme-toggle" role="menuitemcheckbox"
                  aria-checked="false" data-theme-toggle>
            <span class="dropdown-ico" data-theme-icon>☀️</span>
            Modo oscuro
            <span class="theme-switch" aria-hidden="true"></span>
          </button>

          <% if (usuario && (usuario.id_rol === 1 || usuario.id_rol === 3)) { %>
            <a href="/admin" role="menuitem" class="dropdown-item">
              <span class="dropdown-ico">🛡️</span> Panel admin
            </a>
          <% } %>

          <form action="/auth/logout" method="POST" class="dropdown-logout">
            <button type="submit" class="dropdown-item" role="menuitem">
              <span class="dropdown-ico"></span> Cerrar sesión
            </button>
          </form>
        </div>
      </details>
    </header>

    <!-- ========== Contenido ========== -->
    <main class="dash-main">
      <h1 class="dash-title">Hola, <%= nombre %> </h1>
      <p class="muted subtitle">Tu entrenamiento de hoy, según tu perfil.</p>

      <!-- Sugerencia del día -->
      <section class="card hero">
        <span class="tag"><%= prog ? 'Rutina en progreso' : 'Sugerencia de hoy' %></span>
        <h2 class="hero-title" id="sug-nombre"><%= s.nombre %></h2>

        <div class="meta">
          <span id="sug-tipo"><%= s.tipo %></span>
          <span id="sug-minutos">~<%= s.minutos %> min</span>
          <span id="sug-grupo"><%= s.grupo %></span>
          <span id="sug-intensidad">Intensidad <%= String(s.intensidad || '').toLowerCase() %></span>
          <span id="sug-ejercicios"><%= s.ejercicios %> ejercicios</span>
        </div>
        <p class="why">Adaptada a tu perfil: <b id="sug-motivo"><%= s.motivo %></b></p>

        <% if (prog) { %>
          <p class="muted small">Vas en <%= prog.hechos %> de <%= prog.total %> ejercicios</p>
          <div class="bar"><i style="width:<%= Math.round(prog.hechos / prog.total * 100) %>%"></i></div>
        <% } %>

        <div class="acts">
          <a class="cta" id="btn-start" href="/entrenamiento<%= (s.indiceVariante ? '?alt=' + (s.indiceVariante - 1) : '') %>">
            ▶ <%= prog ? 'Retomar entrenamiento' : 'Comenzar entrenamiento' %>
          </a>
          <button type="button" class="ghost" id="btn-swap"
                  data-indice="<%= s.indiceVariante || 1 %>"
                  data-variantes="<%= s.variantes || 1 %>"
                  data-ilimitado="<%= s.ilimitado ? 'true' : 'false' %>"
                  aria-haspopup="dialog">
            ↻ Cambiar sugerencia
            <% if (s.ilimitado) { %>
              <span class="swap-infinito" id="sug-contador" title="Cambios ilimitados con Premium" aria-label="Cambios ilimitados">
                <svg viewBox="0 0 64 32" width="30" height="15" aria-hidden="true" focusable="false">
                  <defs>
                    <linearGradient id="oro-infinito" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#fff1a8"/>
                      <stop offset="45%" stop-color="#ffd700"/>
                      <stop offset="100%" stop-color="#b8860b"/>
                    </linearGradient>
                  </defs>
                  <path d="M32 16C26 6 18 4 12 6 5 8 2 13 2 16s3 8 10 10c6 2 14 0 20-10 6-10 14-12 20-10 7 2 10 7 10 10s-3 8-10 10c-6 2-14 0-20-10Z"
                        fill="none" stroke="url(#oro-infinito)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            <% } else if (s.variantes > 1) { %><span class="muted small" id="sug-contador">(<%= s.indiceVariante %>/<%= s.variantes %>)</span><% } %>
          </button>
        </div>
      </section>

      <!-- Resumen, racha y progreso -->
      <section class="grid">
        <article class="card">
          <h3>Racha actual</h3>
          <div class="big"><%= r.racha %> <%= r.racha === 1 ? 'día' : 'días' %></div>
          <p class="muted small">
            <%= r.racha ? 'consecutivos · tu mejor racha: ' + r.mejorRacha : 'Empieza hoy tu primera racha' %>
          </p>
        </article>

        <article class="card">
          <h3>Meta semanal</h3>
          <div class="big"><%= metaPct %> %</div>
          <div class="bar"><i style="width:<%= metaPct %>%"></i></div>
          <p class="muted small"><%= r.sesiones %> de <%= metaSemanal %> sesiones por semana</p>
        </article>

        <article class="card">
          <h3>Entrenamientos de la semana</h3>
          <div class="big"><%= r.sesiones %> / <%= metaSemanal %></div>
          <div class="week">
            <% diasSemana.forEach(function (d, i) {
                 var cls = String((r.dias && r.dias[i]) || '').split(' ').filter(function (c) { return c && c !== 'plan'; });
                 if (planIdx.includes(i)) cls.push('plan');
                 if (i === r.hoy) cls.push('hoy');
            %>
              <div>
                <i class="<%= cls.join(' ') %>"></i>
                <%= d %>
              </div>
            <% }) %>
          </div>
          <p class="muted small">
            <% if (planIdx.length) { %>
              Entrenas los <%= planIdx.map(function (i) { return diasSemana[i]; }).join(', ') %>.
            <% } else { %>
              Aún no elegiste tus días de entrenamiento.
            <% } %>
          </p>
        </article>
      </section>

      <section class="card">
        <h3>Actividad reciente</h3>
        <% if (actividad.length) { %>
          <% actividad.forEach(function (a) { %>
            <div class="recent"><span><%= a.nombre %></span><span class="muted"><%= a.detalle %></span></div>
          <% }) %>
        <% } else { %>
          <div class="empty">
            <strong>Aún no tienes actividad</strong>
            <span class="muted">Cuando completes tu primer entrenamiento, aquí verás tu resumen y tu racha.</span>
          </div>
        <% } %>
      </section>
    

  
      <!-- Control de calorías -->
      <section class="card calories-card">
        <div class="calories-header">
          <div>
            <h3>Control de calorías</h3>
            <p class="muted small">
              Estimación de la energía que tu cuerpo utiliza en reposo.
            </p>
          </div>
          <span class="calories-icon" aria-hidden="true">🔥</span>
        </div>

        <% if (calorias) { %>
          <div class="calories-result">
            <span class="muted small">Tasa metabólica basal estimada</span>
            <div class="calories-number">
              <%= calorias.tmb.toLocaleString('es-CL') %>
              <span>kcal/día</span>
            </div>
          </div>

          <div class="calories-details">
            <div>
              <span class="muted small">Peso registrado</span>
              <strong><%= calorias.peso %> kg</strong>
            </div>
            <div>
              <span class="muted small">Altura registrada</span>
              <strong><%= calorias.altura %> cm</strong>
            </div>
            <div>
              <span class="muted small">Edad</span>
              <strong><%= calorias.edad %> años</strong>
            </div>
          </div>

          <p class="calories-note muted small">
            Es una estimación en reposo, no una recomendación de consumo
            diario. Tus necesidades también dependen de tu actividad,
            crecimiento y otros factores.
          </p>
        <% } else { %>
          <div class="empty">
            <strong>Necesitamos completar tus datos</strong>
            <span class="muted">
              No encontramos todos los datos necesarios para calcular
              esta estimación.
            </span>
            <a class="cta" href="/configuracion">
              Revisar mi perfil
            </a>
          </div>
        <% } %>
      </section>
    </main>
  </div>

  <%- include('../partials/upgrade_modal') %>

  <script src="/js/dashboard.js"></script>
  <script src="/js/geko-mascot.js"></script>
</body>
</html>