<%
  /* Todo lo que llega aquí viene del controlador con datos reales de la BD.
     Si algo falta, la vista degrada con honestidad en vez de inventar valores. */
  const u = locals.usuario || {};
  const p = locals.perfil || {};
  const nombre = u.nombre || 'Atleta';
  const inicial = nombre.charAt(0).toUpperCase();

  const s = locals.sugerencia || {};
  const r = locals.resumen || { racha: 0, mejorRacha: 0, sesiones: 0, meta: 3, dias: [], hoy: 0 };
  const prog = locals.enProgreso || null;           // { hechos: 2, total: 5 } o null
  const actividad = locals.actividad || [];          // [{ nombre, detalle }]

  const metaPct = r.meta ? Math.min(100, Math.round((r.sesiones / r.meta) * 100)) : 0;
  const diasSemana = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];

  const nivelTexto = { Bajo: 'Principiante', Medio: 'Intermedio', Alto: 'Avanzado' }[p.nivelFisico] || 'Sin nivel';
  const objetivo = p.objetivo || 'Sin objetivo definido';
  const entorno = p.entorno || 'Sin definir';
  const diasTexto = p.diasSemana ? p.diasSemana + (p.diasSemana === 1 ? ' día por semana' : ' días por semana') : 'Sin definir';
  const minutosTexto = p.minutosSesion ? p.minutosSesion + ' min por sesión' : 'Sin definir';

  /* Menú del avatar. "Mi perfil" es el único destino real por ahora. */
  const menu = [
    { href: '/profile',       icono: '', texto: 'Mi perfil' },
    { href: '#',              icono: '', texto: 'Configuración', pronto: true },
    { href: '#',              icono: '', texto: 'Mi progreso',  pronto: true },
    { href: '#',              icono: '', texto: 'Ayuda',        pronto: true }
  ];
%>

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GEKO - Dashboard</title>
  <link rel="stylesheet" href="/css/dashboard.css" />
</head>
<body>
  <div class="dash-page">

    <!-- ========== Barra superior ========== -->
    <header class="dash-nav">
      <div class="logo-brand">
        <img src="/assets/geko.png" alt="GEKO" width="30" height="30" />
        <span class="brand-text">GEKO</span>
      </div>

      <details class="user-menu" id="user-menu">
        <summary class="avatar-btn" aria-label="Abrir menú de usuario"><%= inicial %></summary>

        <div class="dropdown" role="menu">
          <div class="dropdown-head">
            <strong><%= nombre %></strong>
            <span class="muted small">Mi cuenta</span>
          </div>

          <% menu.forEach(function (item) { %>
            <a href="<%= item.href %>" role="menuitem"
               class="dropdown-item<%= item.pronto ? ' is-soon' : '' %>">
              <span class="dropdown-ico"><%= item.icono %></span>
              <%= item.texto %>
              <% if (item.pronto) { %><span class="soon-tag">Pronto</span><% } %>
            </a>
          <% }) %>

          <form action="/auth/logout" method="POST" class="dropdown-logout">
            <button type="submit" class="dropdown-item" role="menuitem">
              <span class="dropdown-ico"></span> Cerrar sesión
            </button>
          </form>
        </div>
      </details>
    </header>

    <!-- ========== Contenido ========== -->
    <main class="dash-main">
      <h1 class="dash-title">Hola, <%= nombre %> </h1>
      <p class="muted subtitle">Tu entrenamiento de hoy, según tu perfil.</p>

      <!-- Resumen del perfil que dejó el wizard de /profile -->
      <section class="card perfil">
        <div class="perfil-head">
          <h3>Tu plan</h3>
          <a class="perfil-edit" href="/profile">Editar perfil</a>
        </div>

        <div class="perfil-grid">
          <div class="perfil-dato">
            <span class="muted small">Objetivo</span>
            <strong><%= objetivo %></strong>
          </div>
          <div class="perfil-dato">
            <span class="muted small">Nivel</span>
            <strong><%= nivelTexto %></strong>
          </div>
          <div class="perfil-dato">
            <span class="muted small">Dónde entrenas</span>
            <strong><%= entorno %></strong>
          </div>
          <div class="perfil-dato">
            <span class="muted small">Frecuencia</span>
            <strong><%= diasTexto %></strong>
          </div>
          <div class="perfil-dato">
            <span class="muted small">Duración</span>
            <strong><%= minutosTexto %></strong>
          </div>
          <% if (p.alturaCm && p.pesoKg) { %>
            <div class="perfil-dato">
              <span class="muted small">Medición actual</span>
              <strong><%= p.alturaCm %> cm · <%= p.pesoKg %> kg</strong>
            </div>
          <% } %>
        </div>

        <% if (p.equipamiento && p.equipamiento.length) { %>
          <div class="perfil-bloque">
            <span class="muted small">Tu equipamiento</span>
            <div class="chips">
              <% p.equipamiento.forEach(function (e) { %>
                <span class="chip"><%= e %></span>
              <% }) %>
            </div>
          </div>
        <% } %>

        <% if (p.lesiones && p.lesiones.length) { %>
          <div class="perfil-bloque">
            <span class="muted small">Limitaciones a considerar</span>
            <div class="chips">
              <% p.lesiones.forEach(function (l) { %>
                <span class="chip chip-alerta"><%= l %></span>
              <% }) %>
            </div>
            <p class="muted small aviso">
              Vamos a tener en cuenta estas zonas al armar tus rutinas.
            </p>
          </div>
        <% } %>
      </section>

      <!-- Sugerencia del día -->
      <section class="card hero">
        <span class="tag"><%= prog ? 'Rutina en progreso' : 'Sugerencia de hoy' %></span>
        <h2 class="hero-title"><%= s.nombre %></h2>

        <div class="meta">
          <span><%= s.tipo %></span>
          <span>~<%= s.minutos %> min</span>
          <span><%= s.grupo %></span>
          <span>Intensidad <%= String(s.intensidad || '').toLowerCase() %></span>
          <span><%= s.ejercicios %> ejercicios</span>
        </div>
        <p class="why">Adaptada a tu perfil: <b><%= s.motivo %></b></p>

        <% if (prog) { %>
          <p class="muted small">Vas en <%= prog.hechos %> de <%= prog.total %> ejercicios</p>
          <div class="bar"><i style="width:<%= Math.round(prog.hechos / prog.total * 100) %>%"></i></div>
        <% } %>

        <div class="acts">
          <a class="cta" href="/entrenamiento<%= (s.indiceVariante ? '?alt=' + (s.indiceVariante - 1) : '') %>">
            ▶ <%= prog ? 'Retomar entrenamiento' : 'Comenzar entrenamiento' %>
          </a>
          <button type="button" class="ghost" id="btn-swap">
            ↻ Cambiar sugerencia
            <% if (s.variantes > 1) { %><span class="muted small">(<%= s.indiceVariante %>/<%= s.variantes %>)</span><% } %>
          </button>
        </div>
      </section>

      <!-- Resumen, racha y progreso -->
      <section class="grid">
        <article class="card">
          <h3>Racha actual</h3>
          <div class="big"><%= r.racha %> <%= r.racha === 1 ? 'día' : 'días' %></div>
          <p class="muted small">
            <%= r.racha ? 'consecutivos · tu mejor racha: ' + r.mejorRacha : 'Empieza hoy tu primera racha' %>
          </p>
        </article>

        <article class="card">
          <h3>Meta semanal</h3>
          <div class="big"><%= metaPct %> %</div>
          <div class="bar"><i style="width:<%= metaPct %>%"></i></div>
          <p class="muted small"><%= r.sesiones %> de <%= r.meta %> sesiones por semana</p>
        </article>

        <article class="card">
          <h3>Entrenamientos de la semana</h3>
          <div class="big"><%= r.sesiones %> / <%= r.meta %></div>
          <div class="week">
            <% diasSemana.forEach(function (d, i) { %>
              <div>
                <i class="<%= (r.dias && r.dias[i]) || '' %><%= i === r.hoy ? ' hoy' : '' %>"></i>
                <%= d %>
              </div>
            <% }) %>
          </div>
          <p class="muted small">
            <% if (r.plan && r.plan.length) { %>
              Entrenas los <%= r.plan.map(function (i) { return diasSemana[i]; }).join(', ') %>.
            <% } %>
          </p>
        </article>
      </section>

      <section class="card">
        <h3>Actividad reciente</h3>
        <% if (actividad.length) { %>
          <% actividad.forEach(function (a) { %>
            <div class="recent"><span><%= a.nombre %></span><span class="muted"><%= a.detalle %></span></div>
          <% }) %>
        <% } else { %>
          <div class="empty">
            <strong>Aún no tienes actividad</strong>
            <span class="muted">Cuando completes tu primer entrenamiento, aquí verás tu resumen y tu racha.</span>
          </div>
        <% } %>
      </section>
    </main>
  </div>

  <script src="/js/dashboard.js"></script>
</body>
</html>
