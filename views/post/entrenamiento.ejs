      <section class="card">
        <h3>Lo que ya sabemos de tu plan</h3>
        <div class="perfil-grid">
          <div class="perfil-dato">
            <span class="muted small">Objetivo</span>
            <strong><%= p.objetivo || 'Sin objetivo definido' %></strong>
          </div>
          <div class="perfil-dato">
            <span class="muted small">Duración</span>
            <strong><%= p.minutosSesion ? p.minutosSesion + ' min por sesión' : 'Sin definir' %></strong>
          </div>
          <div class="perfil-dato">
            <span class="muted small">Frecuencia</span>
            <strong><%= p.diasSemana ? p.diasSemana + ' días por semana' : 'Sin definir' %></strong>
          </div>
          <div class="perfil-dato">
            <span class="muted small">Dónde entrenas</span>
            <strong><%= r.lugarEntrenamiento || p.entorno || 'Sin definir' %></strong>
          </div>
        </div>
        <p class="muted small aviso">
          Puedes ajustar cualquiera de estos datos en
          <a href="/configuracion" class="link">tu perfil</a>.
          Si los cambias, la rutina se genera de nuevo automáticamente.
        </p>
      </section>
    </main>
  </div>

  <script src="/js/dashboard.js"></script>
  <script src="/js/entrenamiento.js"></script>
</body>
</html>
