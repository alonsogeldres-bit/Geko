<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GEKO - Entrenamiento</title>
  <link rel="stylesheet" href="/css/dashboard.css" />
</head>
<body>
  <div class="dash-page">

    <header class="dash-nav">
      <div class="logo-brand">
        <img src="/assets/geko.png" alt="GEKO" width="30" height="30" />
        <span class="brand-text">GEKO</span>
      </div>

      <details class="user-menu" id="user-menu">
        <summary class="avatar-btn" aria-label="Abrir menú de usuario"><%= inicial %></summary>

        <div class="dropdown" role="menu">
          <div class="dropdown-head">
            <strong><%= nombre %></strong>
            <span class="muted small">Mi cuenta</span>
          </div>

          <% menu.forEach(function (item) { %>
            <a href="<%= item.href %>" role="menuitem"
               class="dropdown-item<%= item.pronto ? ' is-soon' : '' %>">
              <span class="dropdown-ico"><%= item.icono %></span>
              <%= item.texto %>
              <% if (item.pronto) { %><span class="soon-tag">Pronto</span><% } %>
            </a>
          <% }) %>

          <form action="/auth/logout" method="POST" class="dropdown-logout">
            <button type="submit" class="dropdown-item" role="menuitem">
              <span class="dropdown-ico"></span> Cerrar sesión
            </button>
          </form>
        </div>
      </details>
    </header>

    <main class="dash-main">
      <h1 class="dash-title">Entrenamiento</h1>
<<<<<<<<< Temporary merge branch 1
      <p class="muted subtitle">La rutina que te armamos para hoy.</p>
=========
      <p class="muted subtitle">La rutina que armamos para hoy según tu perfil.</p>
>>>>>>>>> Temporary merge branch 2

      <p id="rutina-estado" class="rutina-estado" role="status" aria-live="polite"><%= locals.aviso || '' %></p>

<<<<<<<<< Temporary merge branch 1
        <div class="meta">
          <span><%= s.tipo %></span>
          <span>~<%= s.minutos %> min</span>
          <span><%= s.grupo %></span>
          <span>Intensidad <%= String(s.intensidad || '').toLowerCase() %></span>
          <span><%= s.ejercicios %> ejercicios</span>
        </div>
        <p class="why">Adaptada a tu perfil: <b><%= s.motivo %></b></p>
      </section>

      <% if (errorRutina) { %>
      <section class="card rutina-error">
        <h3>No pudimos generar la rutina</h3>
        <p class="muted"><%= errorRutina %></p>
        <div class="acts">
          <a class="ghost" href="/entrenamiento?nueva=1">Reintentar</a>
          <a class="ghost" href="/dashboard">← Volver al dashboard</a>
        </div>
      </section>
      <% } else if (r) { %>
      <section class="card rutina-ia">
        <div class="perfil-head">
          <h3>Tu rutina, ejercicio a ejercicio</h3>
          <% if (r.fuente === 'local') { %>
            <span class="chip chip-alerta">Rutina de respaldo</span>
          <% } %>
        </div>

        <div class="meta">
          <span><%= r.lugarEntrenamiento %></span>
          <span>~<%= r.tiempoTotalMin %> min estimados</span>
          <span><%= r.rutinaPrincipal.length %> ejercicios</span>
        </div>

        <% if (r.calentamiento && r.calentamiento.length) { %>
        <h4 class="rutina-bloque">Calentamiento</h4>
        <div class="lista-ejercicios">
          <% r.calentamiento.forEach(function (ej) { %>
            <article class="ejercicio-card">
              <div class="ejercicio-head">
                <h5><%= ej.nombre %></h5>
                <span class="tag"><%= ej.duracionMin %> min</span>
              </div>
              <% if (ej.descripcion) { %><p class="muted small"><%= ej.descripcion %></p><% } %>
            </article>
          <% }) %>
        </div>
        <% } %>

        <h4 class="rutina-bloque">Rutina principal</h4>
        <div class="lista-ejercicios">
          <% r.rutinaPrincipal.forEach(function (ej) { %>
            <article class="ejercicio-card">
              <div class="ejercicio-head">
                <h5><%= ej.nombre %></h5>
                <span class="tag"><%= ej.series %> × <%= ej.repeticiones %></span>
              </div>
              <% if (ej.descripcion) { %><p class="muted small"><%= ej.descripcion %></p><% } %>
              <span class="muted small">Descanso: <%= ej.descansoSeg %> s</span>
            </article>
          <% }) %>
        </div>

        <% if (r.estiramiento && r.estiramiento.length) { %>
        <h4 class="rutina-bloque">Estiramiento</h4>
        <div class="lista-ejercicios">
          <% r.estiramiento.forEach(function (ej) { %>
            <article class="ejercicio-card">
              <div class="ejercicio-head">
                <h5><%= ej.nombre %></h5>
                <span class="tag"><%= ej.duracionMin %> min</span>
              </div>
              <% if (ej.descripcion) { %><p class="muted small"><%= ej.descripcion %></p><% } %>
            </article>
          <% }) %>
        </div>
        <% } %>

        <div class="acts rutina-acts">
          <a class="ghost" href="/entrenamiento?nueva=1">Generar otra rutina</a>
          <a class="ghost" href="/dashboard">← Volver al dashboard</a>
        </div>
      </section>
      <% } %>
