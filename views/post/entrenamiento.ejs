<%
  const u = locals.usuario || {};
  const p = locals.perfil || {};
  const s = locals.sugerencia || {};
  const esPremium = Boolean(locals.esPremium);       // plan de pago activo: look dorado
  const rutina = locals.rutina || null;
  const errorRutina = locals.errorRutina || null;
  const nombre = u.nombre || 'Atleta';
  const inicial = nombre.charAt(0).toUpperCase();

  const menu = [
    { href: '/dashboard',       icono: '', texto: 'Mi dashboard' },
    { href: '/configuracion',   icono: '', texto: 'Configuración' },
    { href: '/planes',          icono: '', texto: 'Planes' },
    { href: '#',                icono: '', texto: 'Mi progreso',  pronto: true },
    { href: '#',                icono: '', texto: 'Ayuda',        pronto: true }
  ];

  const bloques = rutina ? [
    { titulo: 'Calentamiento',    items: rutina.calentamiento || [],   principal: false },
    { titulo: 'Rutina principal', items: rutina.rutinaPrincipal || [], principal: true },
    { titulo: 'Estiramiento',     items: rutina.estiramiento || [],    principal: false }
  ] : [];
%>

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GEKO - Entrenamiento</title>
  <script src="/js/theme.js"></script>
  <link rel="stylesheet" href="/css/dashboard.css" />
</head>
<body>
  <div class="dash-page entrenamiento-page<%= esPremium ? ' is-premium' : '' %>">

    <header class="dash-nav">
      <div class="logo-brand">
        <img src="/assets/Geko_nigger.png" alt="GEKO" width="30" height="30" data-logo />
        <span class="brand-text">GEKO</span>
        <% if (esPremium) { %><span class="premium-badge">Premium</span><% } %>
      </div>

      <details class="user-menu" id="user-menu">
        <summary class="avatar-btn" aria-label="Abrir menú de usuario"><%= inicial %></summary>

        <div class="dropdown" role="menu">
          <div class="dropdown-head">
            <strong><%= nombre %></strong>
            <span class="muted small">Mi cuenta</span>
          </div>

          <% menu.forEach(function (item) { %>
            <a href="<%= item.href %>" role="menuitem"
               class="dropdown-item<%= item.pronto ? ' is-soon' : '' %>">
              <span class="dropdown-ico"><%= item.icono %></span>
              <%= item.texto %>
              <% if (item.pronto) { %><span class="soon-tag">Pronto</span><% } %>
            </a>
          <% }) %>

          <% if (!esPremium) { %>
            <button type="button" class="dropdown-item theme-toggle" role="menuitemcheckbox"
                    aria-checked="false" data-theme-toggle>
              <span class="dropdown-ico" data-theme-icon>☀️</span>
              Modo oscuro
              <span class="theme-switch" aria-hidden="true"></span>
            </button>
          <% } %>

          <form action="/auth/logout" method="POST" class="dropdown-logout">
            <button type="submit" class="dropdown-item" role="menuitem">
              <span class="dropdown-ico"></span> Cerrar sesión
            </button>
          </form>
        </div>
      </details>
    </header>

    <main class="dash-main">
      <h1 class="dash-title">Entrenamiento</h1>
      <p class="muted subtitle">La rutina que te armamos para hoy.</p>

      <section class="card hero">
        <span class="tag">Rutina de hoy</span>
        <h2 class="hero-title"><%= s.nombre %></h2>

        <div class="meta">
          <span><%= s.tipo %></span>
          <span>~<%= s.minutos %> min</span>
          <span><%= s.grupo %></span>
          <span>Intensidad <%= String(s.intensidad || '').toLowerCase() %></span>
          <span><%= s.ejercicios %> ejercicios</span>
        </div>
        <p class="why">Adaptada a tu perfil: <b><%= s.motivo %></b></p>

        <% if (errorRutina) { %>
          <div class="card rutina-error">
            <h3>No se pudo generar la rutina</h3>
            <p class="muted"><%= errorRutina %></p>
          </div>
        <% } else if (rutina) { %>

          <% if (rutina.fuente === 'local') { %>
            <span class="chip chip-alerta">Rutina de respaldo</span>
          <% } %>

          <% bloques.forEach(function (b) { %>
            <% if (!b.items.length) return; %>
            <h4 class="rutina-bloque"><%= b.titulo %></h4>
            <div class="lista-ejercicios">
              <% b.items.forEach(function (e) { %>
                <article class="ejercicio-card">
                  <div class="ejercicio-head">
                    <h5><%= e.nombre %></h5>
                    <span class="tag">
                      <% if (b.principal) { %>
                        <%= e.series %> × <%= e.repeticiones %> · <%= e.descansoSeg %> s
                      <% } else { %>
                        <%= e.duracionMin %> min
                      <% } %>
                    </span>
                  </div>
                  <p class="muted"><%= e.descripcion %></p>
                </article>
              <% }) %>
            </div>
          <% }) %>

        <% } %>

        <div class="acts rutina-acts">
          <a class="cta" href="/entrenamientoActivo">Comenzar entrenamiento</a>
          <a class="cta" href="/entrenamiento?nueva=1">Generar otra rutina</a>
          <a class="ghost" href="/dashboard">← Volver al dashboard</a>
        </div>
      </section>

      <section class="card">
        <h3>Lo que ya sabemos de tu plan</h3>
        <div class="perfil-grid">
          <div class="perfil-dato">
            <span class="muted small">Objetivo</span>
            <strong><%= p.objetivo || 'Sin objetivo definido' %></strong>
          </div>
          <div class="perfil-dato">
            <span class="muted small">Duración</span>
            <strong><%= p.minutosSesion ? p.minutosSesion + ' min por sesión' : 'Sin definir' %></strong>
          </div>
          <div class="perfil-dato">
            <span class="muted small">Frecuencia</span>
            <strong><%= p.diasSemana ? p.diasSemana + ' días por semana' : 'Sin definir' %></strong>
          </div>
          <div class="perfil-dato">
            <span class="muted small">Dónde entrenas</span>
            <strong><%= p.entorno || 'Sin definir' %></strong>
          </div>
        </div>
        <p class="muted small aviso">
          Puedes ajustar cualquiera de estos datos en
          <a href="/configuracion" class="link">tu perfil</a>.
          Si los cambias, la rutina se genera de nuevo automáticamente.
        </p>
      </section>
    </main>
  </div>

  <script src="/js/dashboard.js"></script>
</body>
</html>