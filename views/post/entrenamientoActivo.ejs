<%
  const esPremium = Boolean(locals.esPremium);
  const reproductor = Array.isArray(locals.reproductor) ? locals.reproductor : [];
  const indiceInicial = Math.min(
    Math.max(0, Number(locals.indice) || 0),
    Math.max(0, reproductor.length - 1)
  );
  const inicial = reproductor[indiceInicial] || null;
  const datos = JSON.stringify({
    ejercicios: reproductor,
    indiceInicial,
    duracionTotalSeg: Number(locals.duracionTotalSeg) || 0,
  }).replace(/</g, '\\u003c');
%>
<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#F5FAF6" />
  <title>GEKO - Entrenamiento Activo</title>
  <script src="/js/theme.js"></script>
  <link rel="stylesheet" href="/css/entrenamientoActivo.css" />
</head>

<body class="<%= esPremium ? 'is-premium' : '' %>">
  <div class="ea-bg-glow"></div>
  <div class="ea-noise"></div>

  <header class="ea-header">
    <a class="ea-logo" href="/dashboard" aria-label="Volver al inicio">
      <img src="/assets/geko-logo.png" alt="GEKO" width="30" height="30" data-logo />
      <span class="ea-logo-text">GEKO</span>
      <span class="ea-badge"><%= esPremium ? 'Premium' : 'Gratis' %></span>
    </a>
  </header>

  <main class="ta-wrapper">
    <div class="ta-container">
      <!-- Columna izquierda: información del ejercicio -->
      <section class="anim-col" aria-label="Ejercicio actual">
        <span class="ea-chip" id="ea-bloque"><%= inicial ? inicial.bloque : 'Rutina' %></span>
        <h1 class="anim-nombre" id="ea-nombre"><%= inicial ? inicial.nombre : 'Entrenamiento' %></h1>

        <div class="anim-meta" id="ea-meta">
          <% if (inicial) { %>
            <% if (inicial.esPrincipal) { %>
              <span><%= inicial.series %> series</span>
              <span><%= inicial.repeticiones %> reps</span>
              <span>≈ <%= inicial.duracionSeg %> s por serie</span>
              <% if (inicial.descansoSeg) { %><span><%= inicial.descansoSeg %> s descanso</span><% } %>
            <% } else { %>
              <span><%= Math.round(inicial.duracionSeg / 60) %> min</span>
            <% } %>
          <% } %>
        </div>
      </section>

      <!-- Columna derecha -->
      <div class="ta-right">
        <!-- Sección Cronómetro -->
        <section class="cronometro" id="ea-cronometro" aria-label="Cronómetro">
          <p class="cronometro-title" id="ea-fase">Listo para empezar</p>

          <div class="ea-timer-ring" id="ea-ring" style="--p: 0">
            <div class="ea-timer-inner">
              <div class="cronometro-time" id="ea-countdown" role="timer" aria-live="off">
                <%= inicial ? String(Math.floor(inicial.duracionSeg / 60)).padStart(2, '0') + ':' + String(inicial.duracionSeg % 60).padStart(2, '0') : '00:00' %>
              </div>
            </div>
          </div>

          <p class="cronometro-serie" id="ea-serie">
            <%= inicial && inicial.esPrincipal ? 'Serie 1 de ' + inicial.series : 'Ejercicio ' + (indiceInicial + 1) + ' de ' + reproductor.length %>
          </p>

          <div class="ea-progress" role="progressbar" aria-label="Progreso del ejercicio" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="ea-progress">
            <span id="ea-progress-bar"></span>
          </div>

          <p class="ea-audio-hint" id="ea-audio-hint" role="status" hidden>
            Toca la pantalla para activar el sonido.
          </p>

          <div class="cronometro-actions">
            <button class="cronometro-btn cronometro-btn-next" id="ea-toggle" type="button">Iniciar</button>
            <button class="cronometro-btn" id="ea-skip" type="button">Saltar</button>
            <button class="cronometro-btn" id="ea-prev" type="button">Anterior</button>
            <button class="cronometro-btn" id="ea-sound" type="button" aria-pressed="false">Sonido</button>
          </div>
        </section>

        <!-- Sección Descripción -->
        <section class="desc" aria-label="Descripción">
          <header class="desc-header">
            <div>
              <h2 class="desc-title">Descripción</h2>
              <p class="desc-subtitle">Cómo hacer el ejercicio</p>
            </div>
          </header>

          <div class="desc-body">
            <p class="desc-descripcion" id="ea-descripcion"><%= inicial && inicial.descripcion ? inicial.descripcion : 'Sigue las indicaciones y mantén un ritmo cómodo.' %></p>

            <div class="ea-next" id="ea-next">
              <span class="ea-next-label">Siguiente</span>
              <strong class="ea-next-nombre" id="ea-next-nombre">—</strong>
              <span class="ea-next-meta" id="ea-next-meta"></span>
            </div>
          </div>
        </section>
      </div>

      <div class="ea-flash" id="ea-flash" role="status" aria-live="assertive"></div>
    </div>
  </main>

  <div class="ea-actions">
    <a class="ea-btn ea-btn-ghost" href="/entrenamiento">← Volver a la rutina</a>
    <a class="ea-btn ea-btn-ghost" href="/dashboard">← Volver al inicio</a>
  </div>

  <!-- Capa de inicio / resumen -->
  <div class="ea-overlay" id="ea-overlay">
    <div class="ea-overlay-card" role="dialog" aria-modal="true" aria-labelledby="ea-overlay-title">
      <span class="ea-chip" id="ea-overlay-kicker">Rutina de hoy</span>
      <h2 class="ea-overlay-title" id="ea-overlay-title">¿Comenzamos?</h2>
      <p class="ea-overlay-text" id="ea-overlay-text">
        Vas a completar tu rutina guiada. La app te avisa con un pitido al terminar cada serie.
      </p>
      <ul class="ea-overlay-stats" id="ea-overlay-stats"></ul>
      <div class="ea-overlay-audio">
        <button class="ea-audio-test" id="ea-audio-test" type="button">Probar sonido</button>
        <span class="ea-audio-status" id="ea-audio-status" role="status" aria-live="polite"></span>
      </div>
      <div class="ea-overlay-actions">
        <button class="ea-start" id="ea-start" type="button">Comenzar entrenamiento</button>
        <a class="ea-btn ea-btn-ghost" id="ea-overlay-secondary" href="/entrenamiento" hidden>Volver a la rutina</a>
      </div>
    </div>
  </div>

  <script type="application/json" id="ea-datos"><%- datos %></script>
  <script src="/js/entrenamientoActivo.js"></script>
</body>

</html>
