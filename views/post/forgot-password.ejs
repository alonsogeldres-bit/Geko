<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GEKO - Recuperar contraseña</title>
  <link rel="stylesheet" href="/css/login.css" />
</head>
<body>

  <div class="auth bg-gradient">

    <header class="auth-nav">
      <div class="logo-brand">
        <img src="/assets/geko.png" alt="GEKO" class="logo-img-small" width="34" height="34" />
        <span class="auth-brand">GEKO</span>
      </div>
    </header>

    <main class="auth-main">
      <div class="auth-card anim-fade-scale">

        <h1 class="auth-title">Recuperar contraseña</h1>

        <p class="auth-subtitle">
          Ingresa el correo con el que te registraste y te enviaremos un enlace
          para crear una nueva contraseña.
        </p>

        <div id="auth-alert"
             class="auth-alert"
             data-variant="error"
             role="alert"
             aria-live="assertive"
             hidden>
          <span class="auth-alert-icon" aria-hidden="true">!</span>
          <div class="auth-alert-body">
            <p class="auth-alert-msg" id="auth-alert-msg"></p>
          </div>
        </div>

        <form id="form-forgot" class="auth-form" action="/forgot-password" method="POST">

          <label class="auth-label" for="forgot-email">Correo electrónico</label>
          <input
            type="email"
            id="forgot-email"
            name="correo"
            class="auth-input"
            placeholder="tucorreo@ejemplo.com"
            autocomplete="email"
            required
          />

          <button type="submit" class="btn btn-lg btn-primary auth-submit">
            Enviar enlace de recuperación
          </button>

        </form>

        <div class="auth-nav-links">
          <span class="auth-nav-text">¿Recordaste tu contraseña?</span>
          <a href="/login" class="btn btn-outline auth-nav-btn">Volver al inicio de sesión</a>
        </div>

      </div>
    </main>

  </div>

</body>
</html>