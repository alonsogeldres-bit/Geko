<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0f0d" />
    <meta name="description" content="GEKO — Entrenamiento inteligente" />
    <title><%= title || 'GEKO | Dashboard' %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="app">
      <!-- ===== Sidebar ===== -->
      <aside class="sidebar">
        <div class="brand">
          <img src="/public/assets/geko.png" alt="GEKO">
        </div>

        <nav class="nav">
          <a class="nav-item active" href="/post">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 11 12 4l8 7"/><path d="M6 10v9h12v-9"/></svg>
            Inicio
          </a>
          <a class="nav-item" href="#">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8 9h8M8 13h5"/></svg>
            Mi Rutina
          </a>
          <a class="nav-item" href="#">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19V9M11 19V5M18 19v-7"/></svg>
            Progreso
          </a>
          <a class="nav-item" href="#">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/></svg>
            Objetivos
          </a>
          <a class="nav-item" href="#">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
            Entrenar
          </a>
          <a class="nav-item" href="#">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v4M5 8l2 2M19 8l-2 2M4 16h16M7 16a5 5 0 0 1 10 0"/></svg>
            Asistente IA
            <span class="nav-badge">IA</span>
          </a>
        </nav>

        <div class="sidebar-footer">
          <div class="plan-card">
            <div><span class="dot"></span><span class="plan-name">Plan <%= user.plan %></span></div>
            <p class="plan-sub">Desbloquea la IA con Premium</p>
          </div>
          <form action="/logout" method="POST">
          <button type="submit" class="logout">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5M21 12H9"/></svg>
            Cerrar sesión
          </button>
          </form>
        </div>
      </aside>

      <!-- ===== Main ===== -->
      <div class="main-wrap">
        <header class="topbar">
          <div class="brand-mini">
            <img src="/public/assets/geko.png" alt="">
            GEKO
          </div>

          <div class="search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" placeholder="Buscar ejercicio, rutina..." />
          </div>

          <div class="user-menu">
            <div class="avatar"><%= user.inicial %></div>
            <span class="user-name"><%= user.nombre %></span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </div>
        </header>

        <main class="dashboard">
          <!-- Saludo -->
          <div class="welcome-row">
            <div class="welcome">
              <div class="avatar lg"><%= user.inicial %></div>
              <div>
                <h1>Buenos días, <%= user.nombre %> 👋</h1>
                <p>Plan <%= user.plan %> · Desbloquea IA con Premium.</p>
              </div>
            </div>
            <div class="welcome-actions">
              <button class="btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
                Historial
              </button>
              <button class="btn btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v4M5 8l2 2M19 8l-2 2M4 16h16M7 16a5 5 0 0 1 10 0"/></svg>
                Mejorar
              </button>
            </div>
          </div>

          <!-- Rutina de hoy + Objetivos -->
          <div class="top-cards">
            <div class="card card-routine">
              <span class="badge">RUTINA DE HOY</span>
              <h2><%= rutinaHoy.titulo %></h2>
              <p class="muted"><%= rutinaHoy.descripcion %></p>
              <div class="pills">
                <span class="pill">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
                  <%= rutinaHoy.duracion %>
                </span>
                <span class="pill">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3s5 4 5 9a5 5 0 0 1-10 0c0-2 1-3 2-4 0 1 1 2 2 1-1-2 0-4 1-6Z"/></svg>
                  <%= rutinaHoy.calorias %>
                </span>
                <span class="pill">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 7v10M18 7v10M2 10v4M22 10v4M6 12h12"/></svg>
                  <%= rutinaHoy.ejercicios %>
                </span>
              </div>
              <button class="btn btn-primary btn-block" data-action="start-training">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                Comenzar entrenamiento
              </button>
            </div>

            <div class="card card-goals">
              <h3>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/></svg>
                Objetivos
              </h3>
              <% metas.forEach(function(m) { %>
                <div class="goal-item">
                  <div class="goal-label">
                    <span><%= m.label %></span>
                    <span><%= m.value %>/<%= m.max %></span>
                  </div>
                  <div class="progress-bar">
                    <div class="progress-fill" style="width:<%= m.pct %>%"></div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

          <!-- Stats -->
          <div class="stat-grid">
            <% stats.forEach(function(s) { %>
              <div class="stat-card">
                <div class="stat-icon">
                  <% if (s.icon === 'flame') { %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3s5 4 5 9a5 5 0 0 1-10 0c0-2 1-3 2-4 0 1 1 2 2 1-1-2 0-4 1-6Z"/></svg>
                  <% } else if (s.icon === 'pulse') { %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12h4l2 7 4-14 2 7h6"/></svg>
                  <% } else if (s.icon === 'trend') { %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m3 17 6-6 4 4 8-8"/><path d="M15 7h6v6"/></svg>
                  <% } else { %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 21h8M12 17v4M6 4h12v4a6 6 0 0 1-12 0V4Z"/><path d="M6 6H4a2 2 0 0 0 2 4M18 6h2a2 2 0 0 1-2 4"/></svg>
                  <% } %>
                </div>
                <div class="stat-label"><%= s.label %></div>
                <div class="stat-value"><%= s.value %></div>
                <div class="stat-sub"><%= s.sub %></div>
              </div>
            <% }) %>
          </div>

          <!-- Rutina recomendada -->
          <section class="section-header">
            <h2>Rutina recomendada</h2>
            <a href="#">Ver todas ›</a>
          </section>
          <div class="routine-grid">
            <% rutinasRecomendadas.forEach(function(r) { %>
              <div class="routine-card">
                <div class="routine-visual">
                  <span class="level"><%= r.nivel.toUpperCase() %></span>
                  🏋️
                </div>
                <h4><%= r.nombre %></h4>
              </div>
            <% }) %>
          </div>

          <!-- Progreso semanal + Tus objetivos -->
          <div class="bottom-grid">
            <div class="card">
              <div class="card-head">
                <h3>Progreso semanal</h3>
                <span class="muted">Lun · Dom</span>
              </div>
              <div class="chart">
                <% progresoSemanal.forEach(function(d) { %>
                  <div class="chart-col">
                    <div class="bar-wrap">
                      <span class="bar-value"><%= d.pct %>%</span>
                      <div class="bar" style="height:<%= d.pct %>%"></div>
                    </div>
                    <span class="bar-label"><%= d.label %></span>
                  </div>  
                <% }) %>
              </div>
            </div>

            <div class="card">
              <h3>Tus objetivos</h3>
              <% objetivos.forEach(function(o) { %>
                <div class="goal-item">
                  <div class="goal-label">
                    <span><%= o.label %></span>
                    <span class="green"><%= o.pct %>%</span>
                  </div>
                  <div class="progress-bar">
                    <div class="progress-fill" style="width:<%= o.pct %>%"></div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

          <!-- Asistente IA -->
          <div class="card ai-card">
            <div class="ai-head">
              <div class="ai-icon">✨</div>
              <div>
                <h3>Asistente GEKO</h3>
                <span class="muted">Función exclusiva Premium</span>
              </div>
            </div>
            <p class="muted">Con Premium tendrás un entrenador con inteligencia artificial. Conectaremos la API cuando esté disponible.</p>
            <div class="ai-input">
              <input type="text" placeholder="Hazte Premium para usar la IA" disabled />
              <button disabled>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m3 20 18-8L3 4l0 7 12 1-12 1z"/></svg>
              </button>
            </div>
          </div>
        </main>
      </div>
    </div>

    <script src="/js/main.js"></script>
  </body>
</html>