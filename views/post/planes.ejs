<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GEKO - Planes</title>
  <link rel="stylesheet" href="/css/paywall.css" />
</head>
<body>
  <div class="planes-wrap">

    <header class="planes-nav">
      <a href="/dashboard" class="planes-brand">
        <img src="/assets/geko.png" alt="GEKO" width="30" height="30" />
        <span>GEKO</span>
      </a>
      <a href="/dashboard" class="planes-back">Volver al dashboard</a>
    </header>

    <%
      // Defensivo: si el controlador en memoria aún no envía estas variables.
      var planes = typeof planes !== 'undefined' && Array.isArray(planes) ? planes : [];
      var suscripcion = typeof suscripcion !== 'undefined' ? suscripcion : null;
      var pendiente = typeof pendiente !== 'undefined' ? pendiente : null;

      function fmtFecha(valor) {
        if (!valor) return null;
        var fecha = valor instanceof Date ? valor : new Date(String(valor) + 'T00:00:00');
        if (isNaN(fecha.getTime())) return null;
        return fecha.toLocaleDateString('es-CL', {
          day: '2-digit',
          month: 'long',
          year: 'numeric'
        });
      }
    %>

    <div class="planes-head">
      <h1>Elige tu plan</h1>
      <p>Empieza gratis. Mejora cuando quieras.</p>

      <% if (typeof suscripcion !== 'undefined' && suscripcion) { %>
        <p class="planes-estado">
          Plan <strong><%= suscripcion.nombre %></strong> activo<% if (suscripcion.fechaTermino) { %>
          hasta el <strong><%= fmtFecha(suscripcion.fechaTermino) %></strong><% } %>.
          <% if (suscripcion.valor > 0) { %>Renueva antes de esa fecha para mantener el acceso.<% } %>
        </p>
      <% } %>
    </div>

    <% if (typeof pendiente !== 'undefined' && pendiente) { %>
      <div class="planes-alert" data-variant="pending" role="status">
        <span class="planes-alert-icon" aria-hidden="true">!</span>
        <span class="planes-alert-msg">
          Tienes un pago pendiente para el plan <strong><%= pendiente.nombre %></strong>.
          Si ya pagaste, recarga la página en unos segundos.
        </span>
      </div>
    <% } %>

    <div id="planes-alert" class="planes-alert" role="alert" hidden>
      <span class="planes-alert-icon" aria-hidden="true">!</span>
      <span class="planes-alert-msg" id="planes-alert-msg"></span>
    </div>

    <main class="planes">
      <% planes.forEach(function (plan) {
           var esGratis = plan.nombre === 'Gratis';
           var esPremium = plan.valor > 0;
           var esActual = suscripcion && suscripcion.nombre === plan.nombre;
      %>
        <section class="plan <%= esPremium ? 'plan-premium' : 'plan-gratis' %>">
          <% if (esActual) { %><span class="plan-badge">Tu plan actual</span><% } %>

          <h2><%= plan.nombre %></h2>
          <p class="plan-precio">
            <%= plan.valor > 0 ? '$' + plan.valor.toLocaleString('es-CL') + ' / mes' : 'Gratis' %>
            <% if (plan.precioUsd > 0) { %>
              <span class="plan-precio-usd">Se cobra US$<%= plan.precioUsd.toFixed(2) %> vía PayPal</span>
            <% } %>
          </p>

          <ul>
            <% if (esGratis) { %>
              <li>Perfil de entrenamiento personalizado</li>
              <li>Sugerencia de rutina del día</li>
              <li>Progreso y racha de actividad</li>
            <% } else { %>
              <li>Todo lo del plan Gratis</li>
              <li>Rutinas adaptadas con IA (pronto)</li>
              <li>Soporte prioritario (pronto)</li>
            <% } %>
          </ul>

          <% if (esActual) { %>
            <button type="button" class="btn-obtener" disabled>Plan activo</button>
          <% } else if (esPremium) { %>
            <button type="button"
                    class="btn-obtener"
                    id="btn-premium"
                    data-plan-id="<%= plan.id %>"
                    data-plan-nombre="<%= plan.nombre %>"
                    data-plan-precio="$<%= plan.valor.toLocaleString('es-CL') %> / mes<% if (plan.precioUsd > 0) { %> · US$<%= plan.precioUsd.toFixed(2) %><% } %>">
              Elegir Premium
            </button>
          <% } else { %>
            <button type="button" class="btn-obtener" id="btn-gratis">Continuar con el plan Gratis</button>
          <% } %>
        </section>
      <% }) %>

      <% if (!planes.length) { %>
        <p class="planes-empty">Todavía no hay planes configurados. Inténtalo más tarde.</p>
      <% } %>
    </main>

    <p class="planes-note">El plan Gratis no requiere datos de pago.</p>
  </div>

  <%- include('../partials/paywall_modal') %>

  <script src="/js/planes.js" defer></script>
</body>
</html>
