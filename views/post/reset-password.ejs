<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GEKO - Crear nueva contraseña</title>
  <link rel="stylesheet" href="/css/login.css" />
</head>
<body>

  <div class="auth bg-gradient">

    <header class="auth-nav">
      <div class="logo-brand">
        <img src="/assets/geko.png" alt="GEKO" class="logo-img-small" width="34" height="34" />
        <span class="auth-brand">GEKO</span>
      </div>
    </header>

    <main class="auth-main">
      <div class="auth-card anim-fade-scale">

        <% if (valid) { %>
          <h1 class="auth-title">Crear nueva contraseña</h1>

          <p class="auth-subtitle">
            Ingresa tu nueva contraseña. Mínimo 6 caracteres.
          </p>

          <div id="auth-alert"
               class="auth-alert"
               data-variant="error"
               role="alert"
               aria-live="assertive"
               hidden>
            <span class="auth-alert-icon" aria-hidden="true">!</span>
            <div class="auth-alert-body">
              <p class="auth-alert-msg" id="auth-alert-msg"></p>
            </div>
          </div>

          <form id="form-reset" class="auth-form">

            <input type="hidden" id="reset-token" value="<%= token %>" />

            <label class="auth-label" for="reset-password">Nueva contraseña</label>
            <input
              type="password"
              id="reset-password"
              name="contrasena"
              class="auth-input"
              placeholder="Mínimo 6 caracteres"
              autocomplete="new-password"
              required
            />

            <label class="auth-label" for="reset-confirm">Repetir contraseña</label>
            <input
              type="password"
              id="reset-confirm"
              name="confirmacion"
              class="auth-input"
              placeholder="Repite la contraseña"
              autocomplete="new-password"
              required
            />

            <button type="submit"
                    class="btn btn-lg btn-primary auth-submit"
                    id="btn-reset">
              Guardar nueva contraseña
            </button>

          </form>

          <div class="auth-nav-links">
            <span class="auth-nav-text">¿Recordaste tu contraseña?</span>
            <a href="/login" class="btn btn-outline auth-nav-btn">Volver al inicio de sesión</a>
          </div>
        <% } else { %>

          <h1 class="auth-title">Enlace no válido</h1>

          <p class="auth-subtitle"><%= reason %></p>

          <div class="auth-nav-links">
            <span class="auth-nav-text">Pide uno nuevo y vuelve a intentarlo.</span>
            <a href="/forgot-password" class="btn btn-primary auth-nav-btn">Solicitar nuevo enlace</a>
          </div>
        <% } %>

      </div>
    </main>

  </div>

  <script src="/js/reset-password.js"></script>

</body>
</html>