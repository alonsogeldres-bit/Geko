<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GEKO</title>
  <script src="/js/theme.js"></script>
  <link rel="stylesheet" href="/css/splash.css" />
</head>
<body>

  <div class="splash bg-gradient">
    <div class="splash-ring ring-outer"></div>
    <div class="splash-ring ring-inner"></div>

    <div class="splash-logo anim-fade-scale">
      <img
        src="/assets/Geko_nigger.png"
        alt="GEKO"
        class="logo-img"
        data-logo
        width="96"
        height="96"
      />
    </div>

    <p class="splash-name anim-fade-in delay-2">GEKO</p>
    <p class="splash-tagline muted anim-fade-in delay-3">
      Entrenamiento inteligente
    </p>
  </div>

  <script src="/js/splash.js"></script>
</body>
</html>